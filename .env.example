# 公共配置模板
# Common Configuration Template (shared by all environments)
# 
# 使用说明：
# 1. 复制此文件为 .env
# 2. 根据实际情况填写配置值
# 3. 敏感信息（密码、密钥等）请放在 .env.local 中

# 【应用配置】
# 应用端口
PORT=3008

# 【数据库配置】
# 数据库主机地址
DB_HOST=localhost
# 数据库用户名
DB_USERNAME=your_db_username
# 数据库端口
DB_PORT=3306
# 数据库密码（敏感信息，建议放在 .env.local）
DB_PASSWORD=your_db_password
# 数据库名称
DB_DATABASE=your_database_name

# 【JWT配置】
# JWT Token 过期时间
JWT_EXPIRES_IN=7d

# 【Redis配置】
# Redis 主机地址
REDIS_HOST=localhost
# Redis 端口
REDIS_PORT=6379
# Redis 数据库编号
REDIS_DB=0
# Redis 键前缀
REDIS_KEY_PREFIX=qm_photo:

# 【邮件配置】
# SMTP 服务类型（可选，如：QQ、Gmail，如果设置了则不需要配置 host 和 port）
SMTP_SERVICE=QQ
# SMTP 服务器地址（如果未设置 SMTP_SERVICE，则需要配置）
SMTP_SERVER=smtp.qq.com
# SMTP 端口（465 为 SSL，587 为 TLS，如果设置了 SMTP_SERVICE 则不需要）
SMTP_PORT=465
# 是否使用 SSL/TLS（当端口为 465 时自动为 true）
SMTP_SECURE=true
# SMTP 用户名（通常是邮箱地址）
SMTP_USERNAME=your_email@example.com
# SMTP 密码（邮箱授权码或密码，敏感信息，建议放在 .env.local）
SMTP_PASSWORD=your_smtp_password
# 发件人邮箱地址（如果未设置，则使用 SMTP_USERNAME）
SMTP_FROM=your_email@example.com
# 发件人名称
SMTP_FROM_NAME=系统通知

# 【OSS配置】
# OSS 地区
OSS_REGION=oss-cn-chengdu
# OSS AccessKey ID（敏感信息，建议放在 .env.local）
OSS_ACCESS_KEY_ID=your_oss_access_key_id
# OSS AccessKey Secret（敏感信息，建议放在 .env.local）
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
# Bucket 名称
OSS_BUCKET=your_bucket_name
# 开启内网端点
OSS_INTERNAL=true
# OSS Endpoint
OSS_ENDPOINT=https://oss-cn-chengdu.aliyuncs.com
# 是否开启 HTTPS
OSS_SECURE=true
# 前缀路径
OSS_PREFIX=qm-photo/dev/
# 图片存储路径前缀
OSS_IMAGE_PREFIX=images/
# 音频存储路径前缀
OSS_AUDIO_PREFIX=audio/
# 视频存储路径前缀
OSS_VIDEO_PREFIX=video/
# CDN 加速域名
OSS_CDN_DOMAIN=your_cdn_domain
# 文件访问过期时间（永不过期）
OSS_EXPIRES=0
