// Prisma Schema 文件
// 使用 MySQL 数据库
// 根据前端文档设计的完整数据库结构

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Test {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  status      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

// ==================== 用户表 ====================
model User {
  id         Int       @id @default(autoincrement())
  userName   String    @unique @map("user_name") @db.VarChar(50)
  password   String    @db.VarChar(255)
  nickName   String?   @map("nick_name") @db.VarChar(50)
  email      String?   @db.VarChar(100)
  avatar     String?   @db.VarChar(500)
  userPhone  String?   @map("user_phone") @db.VarChar(20)
  userGender String?   @default("unknown") @map("user_gender") @db.VarChar(10) // 'male', 'female', 'unknown'
  status     String    @default("1") @db.VarChar(10) // '1'-启用, '2'-禁用
  createBy   Int?      @map("create_by")
  createTime DateTime  @default(now()) @map("create_time") @db.DateTime(0)
  updateBy   Int?      @map("update_by")
  updateTime DateTime? @updatedAt @map("update_time") @db.DateTime(0)
  remark     String?   @db.VarChar(500)

  // 关系
  userRoles UserRole[]

  @@index([status], name: "idx_status")
  @@index([createTime], name: "idx_create_time")
  @@map("users")
}

// ==================== 角色表 ====================
model Role {
  roleId      Int       @id @default(autoincrement()) @map("role_id")
  roleName    String    @map("role_name") @db.VarChar(50)
  roleCode    String    @unique @map("role_code") @db.VarChar(50)
  description String?   @db.VarChar(500)
  enabled     Boolean   @default(true)
  createTime  DateTime  @default(now()) @map("create_time") @db.DateTime(0)
  updateTime  DateTime? @updatedAt @map("update_time") @db.DateTime(0)

  // 关系
  userRoles       UserRole[]
  roleMenus       RoleMenu[]
  roleMenuButtons RoleMenuButton[]

  @@map("roles")
}

// ==================== 菜单表 ====================
model Menu {
  id           Int       @id @default(autoincrement())
  parentId     Int?      @map("parent_id")
  name         String    @db.VarChar(100)
  path         String    @db.VarChar(200)
  component    String?   @db.VarChar(500)
  title        String    @db.VarChar(100)
  icon         String?   @db.VarChar(100)
  isHide       Boolean   @default(false) @map("is_hide")
  isHideTab    Boolean   @default(false) @map("is_hide_tab")
  link         String?   @db.VarChar(500)
  isIframe     Boolean   @default(false) @map("is_iframe")
  keepAlive    Boolean   @default(false) @map("keep_alive")
  isFirstLevel Boolean   @default(false) @map("is_first_level")
  fixedTab     Boolean   @default(false) @map("fixed_tab")
  activePath   String?   @map("active_path") @db.VarChar(200)
  isFullPage   Boolean   @default(false) @map("is_full_page")
  sortOrder    Int       @default(0) @map("sort_order")
  status       String    @default("1") @db.VarChar(10) // '1'-启用, '2'-禁用
  createTime   DateTime  @default(now()) @map("create_time") @db.DateTime(0)
  updateTime   DateTime? @updatedAt @map("update_time") @db.DateTime(0)

  // 自关联关系（父子菜单）
  parent   Menu?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Menu[] @relation("MenuHierarchy")

  // 关系
  menuButtons     MenuButton[]
  roleMenus       RoleMenu[]
  roleMenuButtons RoleMenuButton[]

  @@index([parentId], name: "idx_parent_id")
  @@index([status], name: "idx_status")
  @@index([sortOrder], name: "idx_sort_order")
  @@map("menus")
}

// ==================== 菜单权限按钮表 ====================
model MenuButton {
  id         Int      @id @default(autoincrement())
  menuId     Int      @map("menu_id")
  title      String   @db.VarChar(100)
  authMark   String   @map("auth_mark") @db.VarChar(100)
  sortOrder  Int      @default(0) @map("sort_order")
  createTime DateTime @default(now()) @map("create_time") @db.DateTime(0)

  // 关系
  menu            Menu             @relation(fields: [menuId], references: [id], onDelete: Cascade)
  roleMenuButtons RoleMenuButton[]

  @@unique([menuId, authMark], name: "uk_menu_auth")
  @@index([menuId], name: "idx_menu_id")
  @@map("menu_buttons")
}

// ==================== 用户角色关联表 ====================
model UserRole {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  roleId     Int      @map("role_id")
  createTime DateTime @default(now()) @map("create_time") @db.DateTime(0)

  // 关系
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [roleId], onDelete: Cascade)

  @@unique([userId, roleId], name: "uk_user_role")
  @@index([userId], name: "idx_user_id")
  @@index([roleId], name: "idx_role_id")
  @@map("user_roles")
}

// ==================== 角色菜单关联表 ====================
model RoleMenu {
  id         Int      @id @default(autoincrement())
  roleId     Int      @map("role_id")
  menuId     Int      @map("menu_id")
  createTime DateTime @default(now()) @map("create_time") @db.DateTime(0)

  // 关系
  role Role @relation(fields: [roleId], references: [roleId], onDelete: Cascade)
  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([roleId, menuId], name: "uk_role_menu")
  @@index([roleId], name: "idx_role_id")
  @@index([menuId], name: "idx_menu_id")
  @@map("role_menus")
}

// ==================== 角色菜单按钮关联表 ====================
model RoleMenuButton {
  id         Int      @id @default(autoincrement())
  roleId     Int      @map("role_id")
  menuId     Int      @map("menu_id")
  buttonId   Int      @map("button_id")
  createTime DateTime @default(now()) @map("create_time") @db.DateTime(0)

  // 关系
  role   Role       @relation(fields: [roleId], references: [roleId], onDelete: Cascade)
  menu   Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  button MenuButton @relation(fields: [buttonId], references: [id], onDelete: Cascade)

  @@unique([roleId, menuId, buttonId], name: "uk_role_menu_button")
  @@index([roleId], name: "idx_role_id")
  @@index([menuId], name: "idx_menu_id")
  @@map("role_menu_buttons")
}

// ==================== 角色菜单按钮关联视图 ====================
view RoleMenuButtonDetail {
  id         Int      @map("id")
  roleId     Int      @map("role_id")
  menuId     Int      @map("menu_id")
  buttonId   Int      @map("button_id")
  createTime DateTime @map("create_time") @db.DateTime(0)

  // 角色信息
  roleName    String  @map("role_name") @db.VarChar(50)
  roleCode    String  @map("role_code") @db.VarChar(50)
  roleEnabled Boolean @map("role_enabled")

  // 菜单信息
  menuName      String  @map("menu_name") @db.VarChar(100)
  menuPath      String  @map("menu_path") @db.VarChar(200)
  menuTitle     String  @map("menu_title") @db.VarChar(100)
  menuIcon      String? @map("menu_icon") @db.VarChar(100)
  menuComponent String? @map("menu_component") @db.VarChar(500)
  menuStatus    String  @map("menu_status") @db.VarChar(10)

  // 按钮信息
  buttonTitle     String @map("button_title") @db.VarChar(100)
  buttonAuthMark  String @map("button_auth_mark") @db.VarChar(100)
  buttonSortOrder Int    @map("button_sort_order")

  @@map("v_role_menu_button_detail")
}

// ==================== 字典表（扁平化设计）====================
model Dict {
  id         Int       @id @default(autoincrement())
  typeCode   String    @map("type_code") @db.VarChar(100) // 字典类型编码（如：user_status, user_gender）
  typeName   String    @map("type_name") @db.VarChar(100) // 字典类型名称（如：用户状态、用户性别）
  typeStatus String    @default("1") @map("type_status") @db.VarChar(10) // 字典类型状态 '1'-启用, '2'-禁用
  dataLabel  String    @map("data_label") @db.VarChar(100) // 字典标签（显示名称，如：启用、禁用）
  dataValue  String    @map("data_value") @db.VarChar(100) // 字典值（如：1、2、male、female）
  sortOrder  Int       @default(0) @map("sort_order") // 排序
  status     String    @default("1") @db.VarChar(10) // '1'-启用, '2'-禁用（字典数据状态）
  tagStyle   String?   @map("tag_style") @db.VarChar(100) // 标签样式（用于前端样式，如：success、danger）
  isDefault  Boolean   @default(false) @map("is_default") // 是否默认值
  createBy   Int?      @map("create_by") // 创建人ID
  createTime DateTime  @default(now()) @map("create_time") @db.DateTime(0)
  updateBy   Int?      @map("update_by") // 更新人ID
  updateTime DateTime? @updatedAt @map("update_time") @db.DateTime(0)
  remark     String?   @db.VarChar(500) // 备注

  // 唯一约束：同一类型下字典值必须唯一
  @@unique([typeCode, dataValue], name: "uk_type_value")
  // 唯一约束：同一类型下排序必须唯一
  @@unique([typeCode, sortOrder], name: "uk_type_sort")
  @@index([typeCode], name: "idx_type_code")
  @@index([status], name: "idx_status")
  @@index([typeStatus], name: "idx_type_status")
  @@index([sortOrder], name: "idx_sort_order")
  @@index([createTime], name: "idx_create_time")
  @@map("dicts")
}

// ==================== 通知规则表 ====================
model NotificationRule {
  ruleId            BigInt   @id @default(autoincrement()) @map("rule_id")
  ruleName          String   @map("rule_name") @db.VarChar(100)
  msgSource         String   @map("msg_source") @db.VarChar(50)
  msgType           String   @map("msg_type") @db.VarChar(50)
  noticeMode        Int      @default(3) @map("notice_mode") // 3: 邮箱
  noticeAddress     String   @map("notice_address") @db.VarChar(500)
  noticeAddressName String?  @map("notice_address_name") @db.VarChar(100)
  handlerScript     String?  @map("handler_script") @db.Text
  createUsername    String?  @map("create_username") @db.VarChar(50)
  updateUsername    String?  @map("update_username") @db.VarChar(50)
  noticeStatus      Int      @default(1) @map("notice_status") // 1: 启用, 0: 禁用
  createTime        DateTime @default(now()) @map("create_time") @db.DateTime(0)
  updateTime        DateTime @updatedAt @map("update_time") @db.DateTime(0)

  // 关系
  notificationLogs NotificationLog[]

  @@index([msgSource], name: "idx_msg_source")
  @@index([msgType], name: "idx_msg_type")
  @@index([noticeStatus], name: "idx_notice_status")
  @@index([msgSource, msgType, noticeStatus], name: "idx_msg_source_msg_type_status")
  @@map("notification_rule")
}

// ==================== 通知信息主表 ====================
model NotificationInfo {
  infoId        BigInt   @id @default(autoincrement()) @map("info_id")
  msgSource     String   @map("msg_source") @db.VarChar(50)
  msgType       String   @map("msg_type") @db.VarChar(50)
  noticeContent String?  @map("notice_content") @db.Text
  noticeMode    Int      @map("notice_mode") // 3: 邮箱
  noticeSuccess Int      @default(0) @map("notice_success")
  noticeTotal   Int      @default(0) @map("notice_total")
  noticeTime    DateTime @map("notice_time") @db.DateTime(0)
  createTime    DateTime @default(now()) @map("create_time") @db.DateTime(0)
  updateTime    DateTime @updatedAt @map("update_time") @db.DateTime(0)

  // 关系
  notificationLogs NotificationLog[]

  @@index([msgSource], name: "idx_msg_source")
  @@index([msgType], name: "idx_msg_type")
  @@index([noticeTime], name: "idx_notice_time")
  @@index([msgSource, msgType], name: "idx_msg_source_msg_type")
  @@map("notification_info")
}

// ==================== 通知发送结果明细表 ====================
model NotificationLog {
  id               BigInt    @id @default(autoincrement())
  infoId           BigInt    @map("info_id")
  ruleId           BigInt?   @map("rule_id")
  noticeMode       Int       @map("notice_mode") // 3: 邮箱
  noticeAddress    String    @map("notice_address") @db.VarChar(500)
  noticeResult     String?   @map("notice_result") @db.VarChar(100)
  noticeResultTime DateTime? @map("notice_result_time") @db.DateTime(0)
  description      String?   @map("description") @db.VarChar(500)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  // 关系
  notificationInfo NotificationInfo  @relation(fields: [infoId], references: [infoId], onDelete: Cascade)
  notificationRule NotificationRule? @relation(fields: [ruleId], references: [ruleId], onDelete: SetNull)

  @@index([infoId], name: "idx_info_id")
  @@index([ruleId], name: "idx_rule_id")
  @@index([noticeResult], name: "idx_notice_result")
  @@map("notification_log")
}
