# 开发环境配置模板
# Development Environment Configuration Template
#
# 使用说明：
# 1. 复制此文件为 .env.development
# 2. 根据实际情况填写配置值
# 3. 敏感信息（密码、密钥等）请放在 .env.development.local 中

# 【环境配置】
# 运行环境
NODE_ENV=development

# 【数据库配置】
# 数据库连接 URL（敏感信息，建议放在 .env.development.local）
DATABASE_URL="mysql://username:password@localhost:3306/database_name"
# 数据库密码（敏感信息，建议放在 .env.development.local）
DB_PASSWORD=your_db_password
# 数据库名称
DB_DATABASE=qm_photo_db_dev
# 数据库端口
DB_PORT=3306

# 【JWT配置】
# JWT 密钥（敏感信息，建议放在 .env.development.local）
JWT_SECRET=your_dev_jwt_secret_key

# 【CORS配置】
# 跨域允许的源
CORS_ORIGIN=http://localhost:3008

# 【日志配置】
# 日志级别
LOG_LEVEL=debug

# 【Redis配置】
# Redis 密码（敏感信息，建议放在 .env.development.local）
REDIS_PASSWORD=your_redis_password
# Redis 延迟连接
REDIS_LAZY_CONNECT=false
# Redis 最大重试次数
REDIS_MAX_RETRIES=3
# Redis 启用就绪检查
REDIS_ENABLE_READY_CHECK=true
# Redis 启用离线队列
REDIS_ENABLE_OFFLINE_QUEUE=true
# Redis 默认过期时间（秒）
REDIS_TTL=3600
# Redis 最大缓存项数
REDIS_MAX=100

# 【OSS配置】
# 前缀路径
OSS_PREFIX=qm-photo/dev/
