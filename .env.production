# 生产环境特有配置
# Production Environment Specific Configuration
#
# 注意：此文件只包含非敏感的生产环境配置
# 敏感信息（密码、密钥等）必须放在 .env.production.local 中
# ⚠️ 生产环境必须使用强密码和随机密钥

# 【环境配置】
# 运行环境
NODE_ENV=production

# 【数据库配置】
# 注意：数据库连接 URL 和密码必须放在 .env.production.local 中
# DATABASE_URL="mysql://username:password@localhost:3306/database_name"
# DB_PASSWORD=your_production_db_password
# 数据库名称
DB_DATABASE=qm_photo_db_prod
# 数据库端口
DB_PORT=3306

# 【JWT配置】
# ⚠️ 注意：JWT 密钥必须放在 .env.production.local 中
# JWT_SECRET=your_production_jwt_secret_key

# 【CORS配置】
# 跨域允许的源
CORS_ORIGIN=https://qsmm.fun

# 【日志配置】
# 日志级别
LOG_LEVEL=info

# 【Redis配置】
# 注意：Redis 密码必须放在 .env.production.local 中
# REDIS_PASSWORD=your_production_redis_password
# Redis 延迟连接
REDIS_LAZY_CONNECT=false
# Redis 最大重试次数
REDIS_MAX_RETRIES=3
# Redis 启用就绪检查
REDIS_ENABLE_READY_CHECK=true
# Redis 启用离线队列
REDIS_ENABLE_OFFLINE_QUEUE=true
# Redis 默认过期时间（秒）
REDIS_TTL=3600
# Redis 最大缓存项数
REDIS_MAX=100

# 【自动拉取镜像构建服务】
# 注意：Webhook Token 必须放在 .env.production.local 中
# WEBHOOK_TOKEN=your_webhook_token
# Webhook 服务端口
WEBHOOK_PORT=3009
# Webhook 日志目录
WEBHOOK_LOG_FILE=/tmp/webhook-deploy.log

# 【OSS配置】
# 前缀路径
OSS_PREFIX=qm-photo/prod/
